{
  "expo": {
    "name": "Auralira",
    "slug": "auralira",
    "version": "0.1.0",
    "scheme": "auralira",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101827",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
